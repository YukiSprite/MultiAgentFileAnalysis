# MultiAgentFileAnalysis 环境变量配置
# 将本文件复制为 .env；CLI 会自动加载，已有 shell 环境变量优先。

# OpenAI 兼容 API 配置（必填）
OPENAI_API_KEY=sk-your-api-key-here

# 自定义 API 地址（可选，默认使用 OpenAI 官方）
# OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名（可选，默认 gpt-4o）
OPENAI_MODEL=gpt-4o

# 采样温度（可选，默认 0.0；越低越稳定、越偏向严格复述证据）
OPENAI_TEMPERATURE=0.0

# 推理强度（必填：low/high/max；程序没有默认值）
OPENAI_REASONING_EFFORT=max

# Explorer 工具调用模式：auto 自动探测，native 强制原生，text 强制 JSON 回退
OPENAI_TOOL_MODE=auto
